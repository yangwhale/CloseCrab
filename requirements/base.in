# CloseCrab top-level Python dependencies.
#
# Maintained by humans. Edit this file to add/remove a top-level dep,
# then run `scripts/lock-deps.sh` to regenerate base.lock with the full
# transitive closure (~50 packages).
#
# DO NOT install from this file directly — install from base.lock for
# determinism. This file is the human-readable "what" we depend on;
# base.lock is the machine-readable "exactly which versions" to install.

# ---- Core ----
google-cloud-firestore
google-cloud-speech
google-genai       # **必须 >= 2.x**：语音桥用 AudioTranscriptionConfig 的
                   # custom_vocabulary（1.x 没这个字段）和 language_codes
                   # （1.x 有字段，但 SDK 自己 raise 掉了）。降到 1.x 会在
                   # Live 握手那一步炸，不是启动时炸 —— 只有语音坏，文字照常
fastapi
uvicorn
python-dotenv

# ---- Channels ----
py-cord            # Discord
PyNaCl             # Discord 语音 RTP 传输层加密 (py-cord[voice] extra, 缺了语音连不上)
davey              # Discord 语音 DAVE E2EE 原生实现 (py-cord[voice] extra, 缺了被 4017 拒)
lark-oapi          # 飞书 / Lark
dingtalk-stream    # 钉钉

# ---- NLP ----
jieba              # 中文分词 — S1 召回选词 (缺失则降级 bigram，非硬依赖)
