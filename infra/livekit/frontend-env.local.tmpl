# LiveKit Frontend env — CloseCrab voice IO
# 由 scripts/install-livekit.sh 渲染. 落盘到 ~/livekit-frontend/.env.local (mode 0600), 不要进 git.
#
# LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET 必须和 livekit-server 的 config.yaml 对齐
# (frontend Next.js API route 用同一对 key 签 JWT).
# NEXT_PUBLIC_LIVEKIT_URL 是浏览器侧 wss URL.
# SFU 跟前端不同机时, LIVEKIT_URL 要写 SFU 的**内网**地址, 不是 127.0.0.1.

LIVEKIT_URL=__SFU_URL__
LIVEKIT_API_KEY=__API_KEY__
LIVEKIT_API_SECRET=__API_SECRET__
NEXT_PUBLIC_LIVEKIT_URL=__PUBLIC_WSS_URL__

# ── AGENT_NAME：设不设，取决于 agent 是怎么注册的，两边必须一致 ──────
# 设了它，app/page.tsx 会把这个名字塞进 room_config，变成「**显式派发**」——
# SFU 只会把 job 派给注册时用同一个名字的 worker。
#   · closecrab/voice/livekit_io.py 那套走显式派发，名字是 closecrab-voice-{bot}
#     ⇒ 保留下面这一行。
#   · infra/livekit/agent/agent.py（Gemini Live）是**匿名注册**
#     （WorkerOptions 不传 agent_name），走自动派发 ⇒ 这一行必须**留空或删掉**。
# 名字一对不上，SFU 就打 "not dispatching agent job since no worker is
# available"，浏览器等超时后显示 "agent not in the room" —— **两边都不报错**，
# 只是谁也没等到谁。2026-09-12 踩到，查了很久因为日志全是绿的。
AGENT_NAME=__DEFAULT_AGENT_NAME__

# ── 下面三条只有用 infra/livekit/frontend/ 那套补丁时才需要 ──────────
# 三个都由脚本渲染成**具体值**，不是注释示例。空值等同没设（Node 里空串是
# falsy，三处消费方都按「没配」处理），所以留空是安全的默认。
#
# token 端点：上游那条路由在 NODE_ENV=production 下会直接 throw
# （见 frontend/app/api/token/route.ts 的注释），而 systemd 起的是
# `pnpm start`，必然命中。这个开关**必须显式打开**（--allow-insecure-token），
# 默认仍然拒绝 —— 谁开的、在哪开的都留痕。
# ⚠️ 打开后该端点无鉴权，谁调谁就能拿房间 token。
#    前面必须有一层（IAP / Caddy basicauth / 自己的登录态）才能这么用。
ALLOW_INSECURE_TOKEN=__ALLOW_INSECURE_TOKEN__

# 管理台 /admin 调 RoomService RPC 的地址。必须是**内网** http ——
# 服务端到服务端没有浏览器 cookie，走公网域名会被 IAP 挡住。
# 不给 --admin-url 时，脚本把 LIVEKIT_URL 的 ws:// 换成 http:// 填进来
# （同一个地址的两种 scheme，不是另找了一个来源）。
LIVEKIT_ADMIN_URL=__LIVEKIT_ADMIN_URL__

# ── 允许用 ?room= 进的房间白名单 ────────────────────────────────────
# 一个 bot 一个房间，房间名 == bot 名 == agent 那边的人格文件名
# （`agent/personas/<房间名>.md`）。手机和笔记本带同一个 ?room= 就进同一个
# 房间，各自是一个参与者，麦克风都进 agent 的混音池。
#
# **必须白名单**，不能只做字符校验：这个端点没有自己的鉴权，房间名会一路传到
# agent 那边被拿去拼文件路径。不在名单里的一律 400。
# 这个变量**没设**而请求又带了 ?room= 则 500 —— 故意不兜底成随机房间，
# 否则「白名单忘了配」会伪装成「功能正常但每次都是新房间」，最难查的那种。
#
# ⚠️ 加一个新房间要动**两处**：这里（--allowed-rooms），和 agent 那边的
#    personas/ 目录。两个进程各自校验一遍是故意的 —— 它们可以不在同一台机器上。
ALLOWED_ROOMS=__ALLOWED_ROOMS__

# ── 原生 app（iOS）那条入口 ────────────────────────────────────────
# 浏览器走 /lk，整站在 IAP 后面，靠登录 cookie 过关。原生 app 没有那张 cookie，
# token 请求和 WebSocket 握手都会被弹到 Google 登录页，所以给它开一条
# /native/* —— 在 GCLB url-map 上落到不开 IAP 的后端，鉴权换成 HMAC 验签。
#
# 两个值都由脚本渲染：URL 从 NEXT_PUBLIC_LIVEKIT_URL 推（同一个地址的两条入口，
# 不是另找的来源），密钥从 Firestore config/livekit 的 native_secret 取
# （跟 api_secret 同一个文档，重装能原样取回）。
#
# 验签：HMAC-SHA256(CC_NATIVE_SECRET, "<scope>:<unix 秒>")，十六进制小写，
# ±300 秒时窗。scope 对 /api/token 是房间名、对 /api/rooms 是字面量 rooms ——
# 签进去是为了让一张签名只能用在它申请的那个房间上，抓到也改不成别的房间重放。
#
# **密钥留空 = 整条 native 路关掉**（一律 503），不是「不鉴权放行」。
# 这是故意的：一个忘了配密钥的部署，应该是「手机连不上」而不是
# 「公网上多了一个谁都能调的 token 接口」。
CC_NATIVE_SECRET=__CC_NATIVE_SECRET__

# 给原生 app 回的 signaling 地址。**必须跟 LIVEKIT_URL 不同** ——
# 那个指向 /lk，手机走过去会被 IAP 弹回来。
# native 请求进来而这一项是空的 ⇒ /api/token 直接 500，**不回退**到 LIVEKIT_URL。
# 回退的后果是返回一个手机连不上的地址，症状是「token 拿到了但连接超时」，
# 最难往「配置漏了一行」这个方向想。
LIVEKIT_NATIVE_URL=__LIVEKIT_NATIVE_URL__
