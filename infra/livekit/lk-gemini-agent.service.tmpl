# /etc/systemd/system/lk-gemini-agent.service
# LiveKit agent —— Gemini Live（realtime 模式）
#
# 这个 unit 里有两条注释是拿事故换来的，改之前先读完。

[Unit]
Description=LiveKit agent — Gemini Live (realtime mode)
Documentation=https://docs.livekit.io/agents/
After=network-online.target
Wants=network-online.target
# 这里**不能**写 Requires=livekit-server.service。agent 和 SFU 通常不在
# 同一台机器上（见 agent/env.tmpl 里讲的地域约束），本机根本没有那个 unit；
# 而 Requires= 是硬绑定 —— 一停被依赖的那个，systemd 会把本 unit 一起停掉。
# 2026-09-12 清理本机残留的 livekit-server 时，agent 就是这么被连坐停掉的，
# 表现是「房间里突然没有 agent 了」，看日志只有 exit 255。

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__AGENT_DIR__
Environment=HOME=__HOME__
# 必须钉死 TMPDIR。livekit-agents 用 multiprocessing forkserver，它的 AF_UNIX
# socket 建在 TMPDIR 下，而 AF_UNIX 路径上限 108 字节 —— TMPDIR 一长，worker
# 注册成功但每个 job 进程都起不来，报 "AF_UNIX path too long"。
# 症状具有迷惑性：日志里 "registered worker" 是绿的，坏的是下一层。
Environment=TMPDIR=/tmp
ExecStart=__AGENT_DIR__/.venv/bin/python __AGENT_DIR__/agent.py start
# 重启 = 所有 job 被杀。房间是常驻的，不会再有「房间被创建」这个事件来触发
# 自动派发，所以必须自己把 agent 补回去 —— 否则房间一直空着，要等下一个
# timer 周期（最多 5 分钟）才自愈，那几分钟里进房的人在对着空气说话。
# --reclaim 会先把房间里的旧 agent 尸体踢干净再无条件补派：SFU 的参与者列表
# 在 worker 重启后十几秒内都还挂着死掉的 job，不能拿它判「在不在岗」。
# sleep 只是等 worker 完成注册，5 秒足够。
ExecStartPost=/bin/sh -c '( sleep 5; exec /usr/bin/python3 __AGENT_DIR__/ensure_rooms.py --reclaim ) &'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
