# LiveKit Server config — CloseCrab voice IO
# 由 scripts/install-livekit.sh --component sfu 渲染. __API_KEY__ / __API_SECRET__
# 取自 Firestore config/livekit（没有就现生成并发布上去）.
# 落盘到 /etc/livekit/config.yaml (root:root 0600), **含明文 secret, 不要进 git**.

port: 7880
bind_addresses:
  - "0.0.0.0"
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true
keys:
  __API_KEY__: __API_SECRET__
log_level: info
