# LiveKit Gemini agent env —— 落盘到 ~/lk-gemini-agent/.env (mode 0600)，**不要进 git**
#
# agent.py 用 `load_dotenv(override=True)` 读这个文件。override 必须开 ——
# systemd / shell 里可能已经有同名变量（比如别的项目留下的 GEMINI_API_KEY），
# 不 override 的话 .env 会被静默忽略，表现是「配置明明改了却没生效」。

# Gemini Developer API 的 key（**不是** Vertex）。
# 为什么必须是 Developer API 而不是 Vertex，两个独立的硬约束：
#   1. gemini-3.1-flash-live-preview 在 Vertex 上**根本不存在** ——
#      us-central1 和 global 都回 1008 "Publisher model was not found"。
#      换 Vertex 等于降级到 2.5。
#   2. provider 内置工具（GoogleSearch）和函数工具混用只在 Gemini 3
#      Developer API 上成立，Vertex 会静默丢掉 provider tool。
# 代价：Developer API **按调用方出口 IP 做地域限制**，香港会被拒
#   （1007 "User location is not supported for the API use."）。
#   ⇒ agent 必须跑在受支持的地区，不能跟 SFU 放同一台香港机器。
#   Vertex 没有这个限制（按 project + IAM 授权），但见上面两条。
GEMINI_API_KEY=

# SFU 地址。agent 是服务端到服务端，走**内网**，不经公网也不过 IAP ——
# IAP 是给浏览器用的，agent 没有 cookie。
# 完整 ws URL（`ws://<SFU内网IP>:7880`），跟 Firestore config/livekit.url 同源。
LIVEKIT_URL=__SFU_URL__
LIVEKIT_API_KEY=__API_KEY__
LIVEKIT_API_SECRET=__API_SECRET__
